---
import type { Experience } from "../data/experience";

type Props = { experience: Experience; index?: number };
const { experience, index = 0 } = Astro.props;
---

<article class="xp-row" data-reveal style={`--reveal-i: ${index}`}>
  <span class="row-date mono">{experience.dates}</span>
  <div class="xp-main">
    <span class="xp-role">{experience.role}</span>
    <span class="xp-co">{experience.company}</span>
    {experience.location && <span class="xp-loc mono">{experience.location}</span>}
  </div>
</article>
