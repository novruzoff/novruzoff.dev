---
import { projects } from "../data/projects";
import type { Experience } from "../data/experience";

// One node of the /resume timeline: role over company | dates over
// location, dot on the left (base node styled in global.css, .xp-node),
// then the role's one or two bullets and, when the role has a project
// entry, a link to /projects#<slug>.
// (The compact form without bullets, used by the old home page, was
// removed with it.)
type Props = { experience: Experience };
const { experience } = Astro.props;

// The dates are the source of truth for the dot: a role still running
// gets the filled blue one, everything else the hollow ring.
const isCurrent = experience.dates.toLowerCase().includes("present");

// The link to the role's /projects entry reads as a phrase built from the
// project's own title ("view the true competency project"), not the raw
// path, which a screen reader would spell out ("slash projects number
// sign…"). Taking the title from projects.ts keeps it in step with the
// heading the link lands on. A slug with no matching project gets no link.
const project = experience.projectSlug
  ? projects.find((p) => p.slug === experience.projectSlug)
  : undefined;
const projectHref = project ? `/projects#${project.slug}` : undefined;
---

<li class="xp-node" data-current={isCurrent ? "" : undefined}>
  <div class="xp-main">
    <span class="xp-role">{experience.role}</span>
    <span class="xp-co">{experience.company}</span>
  </div>
  <div class="xp-meta mono">
    <span>{experience.dates}</span>
    {experience.location && <span>{experience.location}</span>}
  </div>

  {
    (experience.highlights || projectHref) && (
      <div class="xp-detail">
        {experience.highlights && (
          <ul class="xp-highlights">
            {experience.highlights.map((line) => <li>{line}</li>)}
          </ul>
        )}
        {project && (
          // The accessible name is the phrase alone: the arrow is a visual
          // cue only (aria-hidden). Label and arrow sit on the <a> line,
          // since whitespace there would render as a gap.
          <a class="xp-more" href={projectHref}>view the {project.title} project<span aria-hidden="true"> →</span></a>
        )}
      </div>
    )
  }
</li>

<style>
  /* Phones: the right-hand date/location column (~120px)
     would squeeze role and company into a narrow strip ("ARB (azerbaijan
     republic broadcaster)" broke over four lines at 375px). One column
     instead, with date and location on a line under the company. The dot
     still centers on the role, which stays first. */
  @media (max-width: 480px) {
    .xp-node {
      grid-template-columns: minmax(0, 1fr);
    }
    .xp-node .xp-meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 12px;
      margin-top: 4px;
      text-align: left;
    }
  }

  /* Spans both columns, under role and dates: the metadata column is
     ~120px wide, so bullets squeezed beside it would wrap every few words
     on a phone. */
  .xp-detail {
    grid-column: 1 / -1;
    margin-top: 8px;
  }

  .xp-highlights {
    max-width: 72ch;
  }
  .xp-highlights li {
    position: relative;
    padding-left: 2ch;
    font-size: 13px;
    line-height: 1.65;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .xp-highlights li + li {
    margin-top: 4px;
  }
  /* Decorative marker; the list semantics already say "bullet". */
  .xp-highlights li::before {
    content: "-";
    content: "-" / "";
    position: absolute;
    left: 0;
    color: var(--text-tertiary);
  }

  /* 6px of block padding: ~31px tall (WCAG 2.5.8). */
  .xp-more {
    display: inline-block;
    margin-top: 2px;
    padding-block: 6px;
    font-size: 12px;
    color: var(--accent);
    transition: color 180ms var(--ease-out-expo);
  }
  .xp-more:hover {
    color: var(--accent-light);
  }
</style>
