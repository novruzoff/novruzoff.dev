---
// Site footer, shared by every page: a copyright line on the left and
// bracket-style links on the right.
//
// The brackets are drawn in CSS (::before / ::after) with empty alt text,
// so they show on screen but aren't announced: each link's accessible name
// is just the word ("github"), which is also the visible word, so voice
// control users can say what they see (WCAG 2.5.3).
type FooterLink = { label: string; href: string; external?: boolean };

type Props = {
  /**
   * Span the full viewport width (.wrap-wide) and drop the top margin and
   * hairline. Only the home page, where the footer closes the panel grid.
   */
  wide?: boolean;
};
const { wide = false } = Astro.props;

const links: FooterLink[] = [
  { label: "github", href: "https://github.com/novruzoff", external: true },
  { label: "linkedin", href: "https://linkedin.com/in/novruzoff", external: true },
  { label: "email", href: "mailto:murad@novruzoff.dev" },
];

const year = new Date().getFullYear();
---

<footer class:list={["site-footer", { "is-wide": wide }]}>
  <div class:list={[wide ? "wrap-wide" : "wrap", "site-footer-inner"]}>
    <span class="site-footer-meta">© {year} murad novruzov · montreal</span>
    <ul class="site-footer-links">
      {/* Label kept on the closing line of the <a>: surrounding whitespace
          would render as a gap inside the CSS brackets ("[ github ]"). */}
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              {...(link.external
                ? { target: "_blank", rel: "noreferrer noopener" }
                : {})}
            >{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(32px, 6vw, 64px);
    border-top: 0.5px solid var(--border-subtle);
  }
  /* Home: the panel grid's frame already closes the page above. */
  .site-footer.is-wide {
    margin-top: 0;
    border-top: 0;
  }

  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    padding-block: 14px 18px;
    font-size: 12px;
  }

  .site-footer-meta {
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .site-footer-links {
    display: flex;
    gap: 16px;
    color: var(--text-secondary);
  }
  /* 6px of block padding makes each link ~31px tall, over the 24px
     minimum target size (WCAG 2.5.8). */
  .site-footer-links a {
    display: inline-block;
    padding-block: 6px;
    transition: color 180ms var(--ease-out-expo);
  }
  .site-footer-links a::before {
    content: "[";
    content: "[" / "";
  }
  .site-footer-links a::after {
    content: "]";
    content: "]" / "";
  }
  .site-footer-links a::before,
  .site-footer-links a::after {
    color: var(--text-tertiary);
    transition: color 180ms var(--ease-out-expo);
  }
  .site-footer-links a:hover {
    color: var(--text-primary);
  }
  .site-footer-links a:hover::before,
  .site-footer-links a:hover::after {
    color: var(--accent);
  }
</style>
