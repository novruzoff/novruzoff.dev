---
// Site footer, shared by every page: a copyright line on the left and the
// social links on the right, plain lowercase words separated by space.
//
// Colour: everything is --accent (the muted blue; 5.41:1 on the page) at
// rest and goes --text-primary on hover and keyboard focus, like the header.
//
// Instagram and X block automated requests (bots get a login wall or an
// error), so a failed link check there doesn't mean a dead link. These
// handles are confirmed by Murad; they're an exception to the "omit links
// that don't resolve" rule (CLAUDE.md).
type FooterLink = { label: string; href: string; external?: boolean };

type Props = {
  /**
   * Span the full viewport width (.wrap-wide) and drop the top margin and
   * hairline. Only the home page, where the footer closes the panel grid.
   */
  wide?: boolean;
};
const { wide = false } = Astro.props;

const links: FooterLink[] = [
  { label: "github", href: "https://github.com/novruzoff", external: true },
  { label: "linkedin", href: "https://www.linkedin.com/in/novruzovmurad/", external: true },
  { label: "instagram", href: "https://www.instagram.com/novruzoffmurad/", external: true },
  { label: "x", href: "https://x.com/novruzoffmurad", external: true },
  { label: "email", href: "mailto:murad@novruzoff.dev" },
];

const year = new Date().getFullYear();
---

<footer class:list={["site-footer", { "is-wide": wide }]}>
  <div class:list={[wide ? "wrap-wide" : "wrap", "site-footer-inner"]}>
    <span class="site-footer-meta">© {year} murad novruzov · montreal</span>
    <ul class="site-footer-links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              {...(link.external
                ? { target: "_blank", rel: "noreferrer noopener" }
                : {})}
            >{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(32px, 6vw, 64px);
    border-top: 0.5px solid var(--border-subtle);
  }
  /* Home: the panel grid's frame already closes the page above. */
  .site-footer.is-wide {
    margin-top: 0;
    border-top: 0;
  }

  /* The copyright line and the links share a row when there's room and
     wrap onto two left-aligned lines when there isn't (phones). */
  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    padding-block: 14px 18px;
    font-size: 12px;
    color: var(--accent);
  }

  .site-footer-meta {
    font-variant-numeric: tabular-nums;
  }

  /* Five links, 29 characters at 12px (7.2px each) plus four 16px gaps:
     273px. That fits the 335px row at 375px and the 280px row at 320px on
     one line; flex-wrap is the safety net for anything narrower, wrapping
     to a second line aligned with the first. */
  .site-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
  }
  /* 6px of block padding makes each link ~31px tall, over the 24px
     minimum target size (WCAG 2.5.8). "x" is only 7px wide, but with
     16px of space on each side its 24px target circle touches nothing. */
  .site-footer-links a {
    display: inline-block;
    padding-block: 6px;
    transition: color 180ms var(--ease-out-expo);
  }
  .site-footer-links a:hover,
  .site-footer-links a:focus-visible {
    color: var(--text-primary);
  }
</style>
