---
// Site footer, shared by every page: the contact and social links only,
// centred, as plain lowercase words separated by space. No copyright line.
//
// Colour: --accent (the muted blue; 5.41:1 on the page) at rest, going
// --text-primary on hover and keyboard focus, like the header.
//
// Instagram and X block automated requests (bots get a login wall or an
// error), so a failed link check there doesn't mean a dead link. These
// handles are confirmed by Murad; they're an exception to the "omit links
// that don't resolve" rule (CLAUDE.md).
type FooterLink = { label: string; href: string; external?: boolean };

type Props = {
  /**
   * Drop the top margin and hairline. Only the home page, where the footer
   * sits straight under the panel grid. (Every page's footer is full width.)
   */
  flush?: boolean;
};
const { flush = false } = Astro.props;

const links: FooterLink[] = [
  { label: "email", href: "mailto:murad@novruzoff.dev" },
  { label: "github", href: "https://github.com/novruzoff", external: true },
  { label: "linkedin", href: "https://www.linkedin.com/in/novruzovmurad/", external: true },
  { label: "instagram", href: "https://www.instagram.com/novruzoffmurad/", external: true },
  { label: "x", href: "https://x.com/novruzoffmurad", external: true },
];
---

<footer class:list={["site-footer", { "is-flush": flush }]}>
  <div class="wrap site-footer-inner">
    <ul class="site-footer-links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              {...(link.external
                ? { target: "_blank", rel: "noreferrer noopener" }
                : {})}
            >{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(32px, 6vw, 64px);
    border-top: 0.5px solid var(--border-subtle);
  }
  /* Home: the panel grid's frame already closes the page above. */
  .site-footer.is-flush {
    margin-top: 0;
    border-top: 0;
  }

  .site-footer-inner {
    padding-block: 14px 18px;
    font-size: 12px;
    color: var(--accent);
  }

  /* Centred at every width. Five links, 29 characters at 12px (7.2px
     each) plus four 16px gaps: 273px, so one line down to 320px (a 280px
     row on the document pages, 288px on home). justify-content centres
     each flex line on its own, so if the links ever wrap, the second
     line is centred too. */
  .site-footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 16px;
  }
  /* 6px of block padding makes each link ~31px tall, over the 24px
     minimum target size (WCAG 2.5.8). "x" is only 7px wide, but with
     16px of space on each side its 24px target circle touches nothing. */
  .site-footer-links a {
    display: inline-block;
    padding-block: 6px;
    transition: color 180ms var(--ease-out-expo);
  }
  .site-footer-links a:hover,
  .site-footer-links a:focus-visible {
    color: var(--text-primary);
  }
</style>
