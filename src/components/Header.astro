---
// Site header, shared by every page: a sticky 52px bar with the handle on
// the left and a link list on the right. No script; it's plain links, so
// keyboard and screen-reader behaviour is native.
//
// Each link gets aria-current="page" when its href is the page being
// rendered. The comparison uses the served URL (/penknife/privacy), not
// Astro.url.pathname: build.format 'file' reports pages as /index.html
// and /penknife/privacy.html, so the extension and the index segment are
// stripped first. Layout.astro normalizes the canonical the same way.
//
// The "/" in front of each label is decorative, drawn in CSS with empty
// alt text, so a screen reader announces "projects", not "slash projects".
//
// Colour: the whole header is --accent (the muted blue) at rest, going
// --text-primary on hover and keyboard focus. With every link blue, colour
// can't mark the current page, so the aria-current link (the name, on the
// home page) is underlined.
export type HeaderLink = { label: string; href: string };

type Props = {
  /** Right-hand links. Defaults to the portfolio's own pages. */
  links?: HeaderLink[];
  /** Accessible name of the <nav> landmark. */
  label?: string;
  /**
   * Span the full viewport width (.wrap-wide) instead of the 828px document
   * column. Only the home page, whose panel grid is full-bleed.
   */
  wide?: boolean;
};

const DEFAULT_LINKS: HeaderLink[] = [
  { label: "projects", href: "/projects" },
  { label: "resume", href: "/resume" },
  { label: "contact", href: "/contact" },
];

const { links = DEFAULT_LINKS, label = "Primary", wide = false } = Astro.props;

const pathname = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";
const current = (href: string) => (href === pathname ? "page" : undefined);
---

<header class="site-header">
  <nav class:list={[wide ? "wrap-wide" : "wrap", "site-header-inner"]} aria-label={label}>
    <a class="site-header-name" href="/" aria-current={current("/")}>novruzoff</a>
    <ul class="site-header-links">
      {/* Label kept on the <a> line: surrounding whitespace would render
          as a gap after the CSS "/" prefix. */}
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={current(link.href)}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    --header-h: 52px;
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 0.5px solid var(--border-subtle);
    /* 94% --bg-page under the blur. The header's text is --accent, and
       content scrolls beneath it (photos, the light statement panel, the
       App Store badge): at 72% a white region underneath brought the text
       to 2.20:1. At 94% the worst case is 4.73:1 (5.41:1 over the page). */
    background: color-mix(in srgb, var(--bg-page) 94%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
  }
  /* Without a backdrop blur the 72% tint would let text show through. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      background: color-mix(in srgb, var(--bg-page) 96%, transparent);
    }
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
  }

  .site-header-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
    transition: color 180ms var(--ease-out-expo);
  }

  .site-header-links {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 13px;
    color: var(--accent);
    white-space: nowrap;
  }
  /* 6px of block padding makes each link ~33px tall, over the 24px
     minimum target size (WCAG 2.5.8). */
  .site-header-links a {
    display: inline-block;
    padding-block: 6px;
    transition: color 180ms var(--ease-out-expo);
  }
  /* The slash takes the link's colour. inline-block keeps the current
     page's underline off it: decorations don't reach inline-block boxes. */
  .site-header-links a::before {
    content: "/";
    content: "/" / "";
    display: inline-block;
  }
  .site-header-name:hover,
  .site-header-name:focus-visible,
  .site-header-links a:hover,
  .site-header-links a:focus-visible {
    color: var(--text-primary);
  }
  /* Current page: a thin underline, the shape of the site's link underline
     but in --accent itself. It's the only cue (every link is blue), so it
     must clear 3:1 as a state indicator (WCAG 1.4.11): --accent is 5.41:1
     on the page, the 35% --accent-border only 1.67:1. */
  .site-header-name[aria-current="page"],
  .site-header-links a[aria-current="page"] {
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  /* Geist Mono is 0.6em per character, so widths are exact. The longest
     set ("/penknife /privacy /support", 25 chars) needs 319px at 13px with
     16px gaps; at 12px with 12px gaps it needs 292px, which fits from
     360px up (320px of row). Under 360px the slashes go too: 270px, inside
     the 280px row at 320px. */
  @media (max-width: 400px) {
    .site-header-inner {
      gap: 12px;
    }
    .site-header-links {
      gap: 12px;
      font-size: 12px;
    }
  }
  @media (max-width: 359px) {
    .site-header-links a::before {
      content: none;
    }
  }
</style>
