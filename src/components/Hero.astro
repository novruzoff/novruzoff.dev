---
// Hero: three-phase entrance, ~2.5s end to end.
// Phase 1 (hold ~1.25s): "Murad Novruzov" centered, sans + italic serif.
// Phase 2 (~0.85s): Murad exits left; Novruzov morphs per-letter into
// "novruzoff" while the word travels to its bottom-anchored rest position.
// Phase 3 (~0.4s): tagline, chrome, and cursor-reactive gradient settle in.
//
// Any scroll during the entrance (wheel, touch, keys, or Lenis) fast-
// forwards it to the settled end state over 100ms: "Murad" is position:
// fixed while it plays, so it must never be left hanging over a scrolled
// page, but resolving reads better than cutting.
// Vanilla WAAPI, no deps. Replays are skipped within a session
// (sessionStorage) because a 5s entrance is for first impressions only.
// Reduced-motion and no-JS users land directly on the settled state via CSS.
// Start states are gated by html.js-hero (see Layout.astro): if this script
// never runs or throws, the gate drops and CSS shows the settled state.
---

<section class="hero" id="top">
  <div class="hero-glow" aria-hidden="true">
    <div class="hero-gradient"></div>
  </div>

  <div class="intro-murad" aria-hidden="true">Murad</div>

  <div class="hero-tagline">
    <span>Software engineer.</span>
    <span>Founding Developer at True Competency, studying CS at McGill.</span>
  </div>

  <div class="hero-bottom">
    <div class="hero-chrome">
      <div class="left mono">Montréal, Canada</div>
      <div class="center">
        <a
          href="https://github.com/novruzoff"
          target="_blank"
          rel="noreferrer noopener">GitHub</a
        ><span class="sep"> / </span><a
          href="https://linkedin.com/in/novruzoff"
          target="_blank"
          rel="noreferrer noopener">LinkedIn</a
        ><span class="sep"> / </span><a href="mailto:murad@novruzoff.dev"
          >Email</a
        >
      </div>
      <nav class="right" aria-label="Sections">
        <a href="#work">Work</a><span class="sep"> · </span><a href="#about"
          >About</a
        ><span class="sep"> · </span><a href="#contact">Contact</a>
      </nav>
    </div>

    <h1 class="hero-name" aria-label="novruzoff">
      <span class="L L-case"
        ><span class="g-up">N</span><span class="g-lo">n</span></span
      ><span class="L">o</span><span class="L">v</span><span class="L">r</span
      ><span class="L">u</span><span class="L">z</span><span class="L">o</span
      ><span class="L L-v-trailing">v</span><span class="L L-f">f</span><span
        class="L L-f">f</span
      >
    </h1>
  </div>
</section>

<script>
  const EASE = "cubic-bezier(0.16, 1, 0.3, 1)";
  const EASE_IN_OUT = "cubic-bezier(0.4, 0, 0.6, 1)";

  // Horizontal-only clips for the v collapse / f reveal. Top and bottom
  // stay open (-0.5em) so descenders are never cut. CLIP_TO_BOX clips at
  // the letter's box (width 0 → nothing shows); CLIP_TO_INK lets the italic
  // f's tail and terminal (up to ~0.14em past the box) show in full.
  const CLIP_TO_BOX = "inset(-0.5em 0em -0.5em 0em)";
  const CLIP_TO_INK = "inset(-0.5em -0.2em -0.5em -0.2em)";

  const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  const nextFrame = () =>
    new Promise<void>((r) => requestAnimationFrame(() => r()));

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const hero = document.querySelector<HTMLElement>(".hero");

  if (hero && !reduce) {
    // Claim the motion gate so Layout's failsafe leaves it in place.
    document.documentElement.classList.add("hero-live");

    const heroEl = hero;
    const introMurad = hero.querySelector<HTMLElement>(".intro-murad")!;
    const heroName = hero.querySelector<HTMLElement>(".hero-name")!;
    const tagline = hero.querySelector<HTMLElement>(".hero-tagline");
    const chrome = hero.querySelector<HTMLElement>(".hero-chrome");
    const gradient = hero.querySelector<HTMLElement>(".hero-gradient");
    const caseMorph = hero.querySelector<HTMLElement>(".L-case");
    const caseUpper = hero.querySelector<HTMLElement>(".g-up");
    const caseLower = hero.querySelector<HTMLElement>(".g-lo");
    const vTrailing = hero.querySelector<HTMLElement>(".L-v-trailing");
    const fNews = Array.from(hero.querySelectorAll<HTMLElement>(".L-f"));

    // The 5s entrance plays once per session; replays land settled fast.
    let seen = false;
    try {
      seen = sessionStorage.getItem("introSeen") === "1";
      sessionStorage.setItem("introSeen", "1");
    } catch {}

    // If the browser restored a scroll position, the intro would play
    // off-screen (and Murad is position:fixed) — settle instead.
    const skipIntro = seen || window.scrollY > window.innerHeight * 0.4;

    // ── Skip-to-end ──────────────────────────────────────────────────
    // Fires once, on the first sign the visitor wants to move down the
    // page. Everything the entrance schedules goes through `after` so a
    // skip can clear what hasn't run yet.
    let skipped = false;
    let lerpStarted = false;
    const timers: number[] = [];
    const after = (fn: () => void, ms: number) => {
      timers.push(window.setTimeout(fn, ms));
    };

    const SKIP_KEYS = new Set([
      "PageDown",
      "PageUp",
      "ArrowDown",
      "ArrowUp",
      "End",
      "Home",
      " ",
      "Spacebar",
    ]);
    const onScrollIntent = () => skipToEnd();
    const onKeyIntent = (e: KeyboardEvent) => {
      if (SKIP_KEYS.has(e.key)) skipToEnd();
    };

    function attachSkip() {
      // Lenis animates native scrollTop, so its scrolls arrive as "scroll".
      window.addEventListener("scroll", onScrollIntent, { passive: true });
      window.addEventListener("wheel", onScrollIntent, { passive: true });
      window.addEventListener("touchmove", onScrollIntent, { passive: true });
      window.addEventListener("keydown", onKeyIntent);
    }
    function detachSkip() {
      window.removeEventListener("scroll", onScrollIntent);
      window.removeEventListener("wheel", onScrollIntent);
      window.removeEventListener("touchmove", onScrollIntent);
      window.removeEventListener("keydown", onKeyIntent);
    }

    // Resolve the entrance over SKIP_MS rather than cutting to the end
    // state: freeze what's on screen, settle the DOM, then animate from the
    // frozen values into the settled ones. finishSkip() then runs exactly
    // the cleanup the instant version did, so the end state is unchanged —
    // only the 100ms it takes to get there is new.
    const SKIP_MS = 100;

    function skipToEnd() {
      if (skipped) return;
      skipped = true;
      detachSkip();
      for (const id of timers) clearTimeout(id);
      timers.length = 0;
      fastForward();
    }

    function snapshot(el: HTMLElement) {
      const cs = getComputedStyle(el);
      return {
        opacity: cs.opacity,
        transform: cs.transform,
        width: cs.width,
        clipPath: cs.clipPath,
      };
    }

    function fastForward() {
      const quick = {
        duration: SKIP_MS,
        easing: EASE,
        fill: "forwards" as const,
      };

      // What the visitor can see right now (WAAPI fills included).
      const nameFrom = snapshot(heroName);
      const caseFrom = caseMorph && snapshot(caseMorph);
      const fFrom = fNews.map(snapshot);
      const vFrom = vTrailing && snapshot(vTrailing);
      const muradFrom = snapshot(introMurad);
      const taglineFrom = tagline && snapshot(tagline);
      const chromeFrom = chrome && snapshot(chrome);
      const glowFrom = gradient && getComputedStyle(gradient).opacity;

      // Settle the DOM. Murad keeps its inline placement (so it fades where
      // it stands instead of jumping to the left edge) and both departing
      // elements stay displayed until the resolve lands.
      settleDom([heroName, caseUpper, caseLower, vTrailing, ...fNews]);
      introMurad.style.display = "block";
      if (vTrailing) vTrailing.style.display = "inline-block";

      // Everything now animates from the frozen values into the settled ones.
      heroName.animate([nameFrom, snapshot(heroName)], quick);
      if (caseMorph && caseFrom) {
        caseMorph.animate([caseFrom, snapshot(caseMorph)], quick);
      }
      fNews.forEach((f, i) => {
        const from = fFrom[i];
        f.animate(
          [
            {
              ...from,
              clipPath: from.clipPath === "none" ? CLIP_TO_BOX : from.clipPath,
            },
            { ...snapshot(f), clipPath: CLIP_TO_INK },
          ],
          quick
        );
      });
      if (vTrailing && vFrom) {
        vTrailing.animate(
          [
            {
              ...vFrom,
              clipPath: vFrom.clipPath === "none" ? CLIP_TO_INK : vFrom.clipPath,
            },
            { ...vFrom, width: "0px", opacity: "0", clipPath: CLIP_TO_BOX },
          ],
          quick
        );
      }
      introMurad.animate([muradFrom, { ...muradFrom, opacity: "0" }], quick);
      if (tagline && taglineFrom) {
        tagline.animate([taglineFrom, snapshot(tagline)], quick);
      }
      if (chrome && chromeFrom) {
        chrome.animate([chromeFrom, snapshot(chrome)], quick);
      }
      if (gradient && glowFrom) {
        gradient.animate([{ opacity: glowFrom }, { opacity: "0.22" }], quick);
      }

      window.setTimeout(finishSkip, SKIP_MS);
    }

    // The same end state and cleanup the instant skip used.
    function finishSkip() {
      release();
      introMurad.style.display = "none";
      if (gradient) {
        gradient.style.opacity = "0.22";
        clearWillChange(gradient);
      }
      startGradientLerp();
    }

    try {
      if (skipIntro) {
        settleFast();
      } else {
        attachSkip();
        runEntrance().catch(release);
      }
    } catch {
      release();
    }

    function setGlyphEndState() {
      if (caseUpper) caseUpper.style.display = "none";
      if (caseLower) caseLower.style.display = "inline";
      if (vTrailing) vTrailing.style.display = "none";
      for (const f of fNews) {
        f.style.width = "auto";
        f.style.opacity = "1";
      }
    }

    // will-change comes from the gate CSS; drop it once an element is done
    // animating so it stops holding a compositor layer.
    function clearWillChange(el: HTMLElement | null) {
      if (el) el.style.willChange = "auto";
    }

    // Stop the entrance, drop the gate, and let CSS show the settled state
    // instead of an invisible or half-morphed hero. Shared by the failure
    // path and by skipToEnd.
    function release() {
      settleDom([introMurad, heroName, caseUpper, caseLower, vTrailing, ...fNews]);
    }

    // Cancel the entrance animations, wipe the inline styles the entrance
    // set on the given elements, and drop the gate so CSS shows the settled
    // state. The caller picks what to wipe: the fast-forward keeps Murad's
    // placement so it can fade out where it stands.
    function settleDom(wipe: (HTMLElement | null)[]) {
      try {
        for (const a of heroEl.getAnimations({ subtree: true })) {
          if (!(a instanceof CSSAnimation) && !(a instanceof CSSTransition)) {
            a.cancel();
          }
        }
      } catch {}
      for (const el of wipe) {
        el?.removeAttribute("style");
      }
      document.documentElement.classList.remove("js-hero");
    }

    function settleFast() {
      introMurad.style.display = "none";
      clearWillChange(introMurad);
      setGlyphEndState();
      heroName
        .animate(
          [
            { opacity: 0, transform: "translateY(12px)" },
            { opacity: 1, transform: "none" },
          ],
          { duration: 600, easing: EASE, fill: "forwards" }
        )
        .finished.then(() => clearWillChange(heroName))
        .catch(() => {});
      tagline?.animate(
        [
          { opacity: 0, transform: "translateY(8px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 500, easing: EASE, delay: 80, fill: "forwards" }
      );
      chrome?.animate(
        [
          { opacity: 0, transform: "translateY(8px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 500, easing: EASE, delay: 160, fill: "forwards" }
      );
      gradient
        ?.animate([{ opacity: 0 }, { opacity: 0.22 }], {
          duration: 600,
          easing: "ease-out",
          delay: 200,
          fill: "forwards",
        })
        .finished.then(() => clearWillChange(gradient))
        .catch(() => {});
      startGradientLerp();
    }

    async function runEntrance() {
      // Don't burn the entrance in a background tab.
      if (document.visibilityState === "hidden") {
        await new Promise<void>((r) =>
          document.addEventListener("visibilitychange", () => r(), {
            once: true,
          })
        );
      }
      // Measure with the real serif loaded, not the fallback.
      try {
        await Promise.race([document.fonts.ready, wait(900)]);
      } catch {}
      await nextFrame();
      if (skipped) return;

      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const finalSize = parseFloat(getComputedStyle(heroName).fontSize);
      const introSize = parseFloat(getComputedStyle(introMurad).fontSize);
      const scale = introSize / finalSize;

      // Natural widths of the two incoming f's, measured invisibly
      // before any transform is applied (rects would be scaled later).
      const fTargets = fNews.map((f) => {
        f.style.width = "auto";
        const w = f.getBoundingClientRect().width;
        f.style.width = "0px";
        return w;
      });

      const nameRect = heroName.getBoundingClientRect();
      const muradW = introMurad.getBoundingClientRect().width;
      const gap = Math.max(24, vw * 0.018);
      const introNameW = nameRect.width * scale;
      const introNameH = nameRect.height * scale;
      const pairW = muradW + gap + introNameW;
      const stacked = pairW > vw - 40;

      let muradLeft: number;
      let nameLeft: number;
      let nameCenterY = vh / 2;
      if (stacked) {
        // Narrow viewports: Murad above, Novruzov below, both centered.
        muradLeft = (vw - muradW) / 2;
        nameLeft = (vw - introNameW) / 2;
        introMurad.style.top = `calc(50% - ${introSize * 0.8}px)`;
        nameCenterY = vh / 2 + introSize * 0.8;
      } else {
        muradLeft = (vw - pairW) / 2;
        nameLeft = muradLeft + muradW + gap;
      }
      introMurad.style.left = `${muradLeft}px`;

      const tx = nameLeft - nameRect.left;
      const ty = nameCenterY - introNameH / 2 - nameRect.top;
      heroName.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;

      // ── Phase 1: fade in, then hold so the name can actually be read ──
      const nameFade = heroName.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 200,
        easing: EASE,
        fill: "forwards",
      });
      introMurad.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 200,
        easing: EASE,
        fill: "forwards",
      });
      await wait(1250);
      if (skipped) return;

      // ── Phase 2: Murad exits; the word morphs and travels ──
      const muradExit = introMurad.animate(
        [
          { transform: "translateY(-50%) translateX(0)", opacity: 1 },
          { transform: "translateY(-50%) translateX(-40vw)", opacity: 0 },
        ],
        { duration: 350, easing: EASE, fill: "forwards" }
      );
      muradExit.finished
        .then(() => {
          introMurad.style.display = "none";
          clearWillChange(introMurad);
        })
        .catch(() => {});

      const travel = heroName.animate(
        [
          { transform: `translate(${tx}px, ${ty}px) scale(${scale})` },
          { transform: "translate(0, 0) scale(1)" },
        ],
        { duration: 750, easing: EASE, fill: "forwards" }
      );

      const morphAnims = scheduleMorph(fTargets);

      await wait(850);
      if (skipped) return;

      // ── Phase 3: tagline, chrome, gradient ──
      tagline?.animate(
        [
          { opacity: 0, transform: "translateY(8px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 250, easing: EASE, fill: "forwards" }
      );
      chrome?.animate(
        [
          { opacity: 0, transform: "translateY(8px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 250, easing: EASE, delay: 40, fill: "forwards" }
      );
      gradient
        ?.animate([{ opacity: 0 }, { opacity: 0.22 }], {
          duration: 300,
          easing: "ease-out",
          fill: "forwards",
        })
        .finished.then(() => clearWillChange(gradient))
        .catch(() => {});
      startGradientLerp();

      // ── Finalize: clear pixel-locked widths/transforms so the layout
      // survives window resizes after the entrance. ──
      await wait(400);
      if (skipped) return;
      heroName.style.opacity = "1";
      heroName.style.transform = "";
      setGlyphEndState();
      clearWillChange(heroName);
      try {
        nameFade.cancel();
        travel.cancel();
        for (const a of morphAnims) a.cancel();
      } catch {}

      // Settled on its own — nothing left to skip, so stop listening.
      detachSkip();
      skipped = true;
    }

    function scheduleMorph(fTargets: number[]) {
      const anims: Animation[] = [];

      // N → n: scaleY squash; glyph swaps at the squash midpoint where
      // the eye can't read detail. One motion, not two events.
      after(() => {
        if (!caseMorph) return;
        anims.push(
          caseMorph.animate(
            [
              { transform: "scaleY(1)" },
              { transform: "scaleY(0.18)", offset: 0.5 },
              { transform: "scaleY(1)" },
            ],
            { duration: 220, easing: EASE_IN_OUT, fill: "forwards" }
          )
        );
        after(() => {
          if (caseUpper) caseUpper.style.display = "none";
          if (caseLower) caseLower.style.display = "inline";
        }, 110);
      }, 100);

      // Trailing v: collapse width + opacity. offsetWidth is layout
      // width — immune to the scale transform mid-travel.
      after(() => {
        if (!vTrailing) return;
        const w = vTrailing.offsetWidth;
        anims.push(
          vTrailing.animate(
            [
              { width: `${w}px`, opacity: 1, clipPath: CLIP_TO_INK },
              { width: "0px", opacity: 0, clipPath: CLIP_TO_BOX },
            ],
            { duration: 260, easing: EASE_IN_OUT, fill: "forwards" }
          )
        );
      }, 130);

      // The two f's: expand from width 0, same mechanism as the v
      // in reverse so the morph reads as one operation.
      fTargets.forEach((w, i) => {
        after(
          () => {
            const f = fNews[i];
            if (!f) return;
            anims.push(
              f.animate(
                [
                  { width: "0px", opacity: 0, clipPath: CLIP_TO_BOX },
                  { width: `${w}px`, opacity: 1, clipPath: CLIP_TO_INK },
                ],
                { duration: 230, easing: EASE, fill: "forwards" }
              )
            );
          },
          260 + i * 30
        );
      });

      return anims;
    }

    // Cursor glow: eases toward the pointer by transform only, so the layer
    // never repaints. The loop idles once the glow settles and stays off
    // while the tab is hidden or the hero is scrolled out of view.
    function startGradientLerp() {
      if (lerpStarted) return;
      if (!gradient) return;
      if (window.matchMedia("(hover: none)").matches) return;
      lerpStarted = true;
      const glow = gradient;

      const damping = 0.08;
      let pointerX = window.innerWidth / 2;
      let pointerY = window.innerHeight * 0.25;
      let x = 0;
      let y = 0;
      let raf = 0;
      let inView = true;

      // The glow is absolute inside the hero: aim in hero-local coordinates.
      const aim = () => {
        const r = heroEl.getBoundingClientRect();
        return { tx: pointerX - r.left, ty: pointerY - r.top };
      };
      const paint = () => {
        glow.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      };
      const tick = () => {
        const { tx, ty } = aim();
        x += (tx - x) * damping;
        y += (ty - y) * damping;
        if (Math.abs(tx - x) < 0.1 && Math.abs(ty - y) < 0.1) {
          x = tx;
          y = ty;
          paint();
          raf = 0;
          return;
        }
        paint();
        raf = requestAnimationFrame(tick);
      };
      const run = () => {
        if (!raf && inView && !document.hidden) {
          raf = requestAnimationFrame(tick);
        }
      };
      const halt = () => {
        cancelAnimationFrame(raf);
        raf = 0;
      };

      const start = aim();
      x = start.tx;
      y = start.ty;
      paint();

      window.addEventListener(
        "mousemove",
        (e) => {
          pointerX = e.clientX;
          pointerY = e.clientY;
          run();
        },
        { passive: true }
      );
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) halt();
        else run();
      });
      new IntersectionObserver((entries) => {
        for (const entry of entries) inView = entry.isIntersecting;
        if (inView) run();
        else halt();
      }).observe(heroEl);
    }
  }
</script>
