---
// Hero: three-phase entrance.
// Phase 1 (hold ~2.5s): "Murad Novruzov" centered, sans + italic serif.
// Phase 2 (~1.8s): Murad exits left; Novruzov morphs per-letter into
// "novruzoff" while the word travels to its bottom-anchored rest position.
// Phase 3: tagline, chrome, and cursor-reactive gradient settle in.
//
// Vanilla WAAPI, no deps. Replays are skipped within a session
// (sessionStorage) because a 5s entrance is for first impressions only.
// Reduced-motion and no-JS users land directly on the settled state via CSS.
---

<section class="hero" id="top">
  <div class="hero-gradient" aria-hidden="true"></div>

  <div class="intro-murad" aria-hidden="true">Murad</div>

  <div class="hero-tagline">
    <span>Software engineer, CTO at True Competency.</span>
    <span>CS at McGill, based in Montreal.</span>
  </div>

  <div class="hero-bottom">
    <div class="hero-chrome">
      <div class="left mono">→ v1.0</div>
      <div class="center">
        <a
          href="https://github.com/novruzoff"
          target="_blank"
          rel="noreferrer noopener">GitHub</a
        ><span class="sep"> / </span><a
          href="https://linkedin.com/in/novruzoff"
          target="_blank"
          rel="noreferrer noopener">LinkedIn</a
        ><span class="sep"> / </span><a href="mailto:murad@novruzoff.dev"
          >Email</a
        >
      </div>
      <nav class="right" aria-label="Sections">
        <a href="#work">Work</a><span class="sep"> · </span><a href="#about"
          >About</a
        ><span class="sep"> · </span><a href="#contact">Contact</a>
      </nav>
    </div>

    <h1 class="hero-name" aria-label="novruzoff">
      <span class="L L-case"
        ><span class="g-up">N</span><span class="g-lo">n</span></span
      ><span class="L">o</span><span class="L">v</span><span class="L">r</span
      ><span class="L">u</span><span class="L">z</span><span class="L">o</span
      ><span class="L L-v-trailing">v</span><span class="L L-f">f</span><span
        class="L L-f">f</span
      >
    </h1>
  </div>
</section>

<script>
  const EASE = "cubic-bezier(0.16, 1, 0.3, 1)";
  const EASE_IN_OUT = "cubic-bezier(0.4, 0, 0.6, 1)";

  const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  const nextFrame = () =>
    new Promise<void>((r) => requestAnimationFrame(() => r()));

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const hero = document.querySelector<HTMLElement>(".hero");

  if (hero && !reduce) {
    const introMurad = hero.querySelector<HTMLElement>(".intro-murad")!;
    const heroName = hero.querySelector<HTMLElement>(".hero-name")!;
    const tagline = hero.querySelector<HTMLElement>(".hero-tagline");
    const chrome = hero.querySelector<HTMLElement>(".hero-chrome");
    const gradient = hero.querySelector<HTMLElement>(".hero-gradient");
    const caseMorph = hero.querySelector<HTMLElement>(".L-case");
    const caseUpper = hero.querySelector<HTMLElement>(".g-up");
    const caseLower = hero.querySelector<HTMLElement>(".g-lo");
    const vTrailing = hero.querySelector<HTMLElement>(".L-v-trailing");
    const fNews = Array.from(hero.querySelectorAll<HTMLElement>(".L-f"));

    // The 5s entrance plays once per session; replays land settled fast.
    let seen = false;
    try {
      seen = sessionStorage.getItem("introSeen") === "1";
      sessionStorage.setItem("introSeen", "1");
    } catch {}

    // If the browser restored a scroll position, the intro would play
    // off-screen (and Murad is position:fixed) — settle instead.
    const skipIntro = seen || window.scrollY > window.innerHeight * 0.4;

    if (skipIntro) {
      settleFast();
    } else {
      void runEntrance();
    }

    function setGlyphEndState() {
      if (caseUpper) caseUpper.style.display = "none";
      if (caseLower) caseLower.style.display = "inline";
      if (vTrailing) vTrailing.style.display = "none";
      for (const f of fNews) {
        f.style.width = "auto";
        f.style.opacity = "1";
      }
    }

    function settleFast() {
      introMurad.style.display = "none";
      setGlyphEndState();
      heroName.animate(
        [
          { opacity: 0, transform: "translateY(12px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 600, easing: EASE, fill: "forwards" }
      );
      tagline?.animate(
        [
          { opacity: 0, transform: "translateY(8px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 500, easing: EASE, delay: 80, fill: "forwards" }
      );
      chrome?.animate(
        [
          { opacity: 0, transform: "translateY(8px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 500, easing: EASE, delay: 160, fill: "forwards" }
      );
      gradient?.animate([{ opacity: 0 }, { opacity: 0.22 }], {
        duration: 600,
        easing: "ease-out",
        delay: 200,
        fill: "forwards",
      });
      startGradientLerp();
    }

    async function runEntrance() {
      // Don't burn the entrance in a background tab.
      if (document.visibilityState === "hidden") {
        await new Promise<void>((r) =>
          document.addEventListener("visibilitychange", () => r(), {
            once: true,
          })
        );
      }
      // Measure with the real serif loaded, not the fallback.
      try {
        await Promise.race([document.fonts.ready, wait(900)]);
      } catch {}
      await nextFrame();

      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const finalSize = parseFloat(getComputedStyle(heroName).fontSize);
      const introSize = parseFloat(getComputedStyle(introMurad).fontSize);
      const scale = introSize / finalSize;

      // Natural widths of the two incoming f's, measured invisibly
      // before any transform is applied (rects would be scaled later).
      const fTargets = fNews.map((f) => {
        f.style.width = "auto";
        const w = f.getBoundingClientRect().width;
        f.style.width = "0px";
        return w;
      });

      const nameRect = heroName.getBoundingClientRect();
      const muradW = introMurad.getBoundingClientRect().width;
      const gap = Math.max(24, vw * 0.018);
      const introNameW = nameRect.width * scale;
      const introNameH = nameRect.height * scale;
      const pairW = muradW + gap + introNameW;
      const stacked = pairW > vw - 40;

      let muradLeft: number;
      let nameLeft: number;
      let nameCenterY = vh / 2;
      if (stacked) {
        // Narrow viewports: Murad above, Novruzov below, both centered.
        muradLeft = (vw - muradW) / 2;
        nameLeft = (vw - introNameW) / 2;
        introMurad.style.top = `calc(50% - ${introSize * 0.8}px)`;
        nameCenterY = vh / 2 + introSize * 0.8;
      } else {
        muradLeft = (vw - pairW) / 2;
        nameLeft = muradLeft + muradW + gap;
      }
      introMurad.style.left = `${muradLeft}px`;

      const tx = nameLeft - nameRect.left;
      const ty = nameCenterY - introNameH / 2 - nameRect.top;
      heroName.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;

      // ── Phase 1: fade in, then hold so the name can actually be read ──
      const nameFade = heroName.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 400,
        easing: EASE,
        fill: "forwards",
      });
      introMurad.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 400,
        easing: EASE,
        fill: "forwards",
      });
      await wait(2500);

      // ── Phase 2: Murad exits; the word morphs and travels ──
      const muradExit = introMurad.animate(
        [
          { transform: "translateY(-50%) translateX(0)", opacity: 1 },
          { transform: "translateY(-50%) translateX(-40vw)", opacity: 0 },
        ],
        { duration: 700, easing: EASE, fill: "forwards" }
      );
      muradExit.finished
        .then(() => {
          introMurad.style.display = "none";
        })
        .catch(() => {});

      const travel = heroName.animate(
        [
          { transform: `translate(${tx}px, ${ty}px) scale(${scale})` },
          { transform: "translate(0, 0) scale(1)" },
        ],
        { duration: 1500, easing: EASE, fill: "forwards" }
      );

      const morphAnims = scheduleMorph(fTargets);

      await wait(1700);

      // ── Phase 3: tagline, chrome, gradient ──
      tagline?.animate(
        [
          { opacity: 0, transform: "translateY(8px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 500, easing: EASE, fill: "forwards" }
      );
      chrome?.animate(
        [
          { opacity: 0, transform: "translateY(8px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 500, easing: EASE, delay: 80, fill: "forwards" }
      );
      gradient?.animate([{ opacity: 0 }, { opacity: 0.22 }], {
        duration: 600,
        easing: "ease-out",
        fill: "forwards",
      });
      startGradientLerp();

      // ── Finalize: clear pixel-locked widths/transforms so the layout
      // survives window resizes after the entrance. ──
      await wait(800);
      heroName.style.opacity = "1";
      heroName.style.transform = "";
      setGlyphEndState();
      try {
        nameFade.cancel();
        travel.cancel();
        for (const a of morphAnims) a.cancel();
      } catch {}
    }

    function scheduleMorph(fTargets: number[]) {
      const anims: Animation[] = [];

      // N → n: scaleY squash; glyph swaps at the squash midpoint where
      // the eye can't read detail. One motion, not two events.
      setTimeout(() => {
        if (!caseMorph) return;
        anims.push(
          caseMorph.animate(
            [
              { transform: "scaleY(1)" },
              { transform: "scaleY(0.18)", offset: 0.5 },
              { transform: "scaleY(1)" },
            ],
            { duration: 440, easing: EASE_IN_OUT, fill: "forwards" }
          )
        );
        setTimeout(() => {
          if (caseUpper) caseUpper.style.display = "none";
          if (caseLower) caseLower.style.display = "inline";
        }, 220);
      }, 200);

      // Trailing v: collapse width + opacity. offsetWidth is layout
      // width — immune to the scale transform mid-travel.
      setTimeout(() => {
        if (!vTrailing) return;
        const w = vTrailing.offsetWidth;
        anims.push(
          vTrailing.animate(
            [
              { width: `${w}px`, opacity: 1 },
              { width: "0px", opacity: 0 },
            ],
            { duration: 520, easing: EASE_IN_OUT, fill: "forwards" }
          )
        );
      }, 260);

      // The two f's: expand from width 0, same mechanism as the v
      // in reverse so the morph reads as one operation.
      fTargets.forEach((w, i) => {
        setTimeout(
          () => {
            const f = fNews[i];
            if (!f) return;
            anims.push(
              f.animate(
                [
                  { width: "0px", opacity: 0 },
                  { width: `${w}px`, opacity: 1 },
                ],
                { duration: 460, easing: EASE, fill: "forwards" }
              )
            );
          },
          520 + i * 60
        );
      });

      return anims;
    }

    function startGradientLerp() {
      if (!gradient) return;
      if (window.matchMedia("(hover: none)").matches) return;

      let targetX = window.innerWidth / 2;
      let targetY = window.innerHeight * 0.25;
      let currentX = targetX;
      let currentY = targetY;
      const damping = 0.08;

      window.addEventListener(
        "mousemove",
        (e) => {
          targetX = e.clientX;
          targetY = e.clientY;
        },
        { passive: true }
      );

      const tick = () => {
        currentX += (targetX - currentX) * damping;
        currentY += (targetY - currentY) * damping;
        gradient.style.setProperty("--mx", `${currentX}px`);
        gradient.style.setProperty("--my", `${currentY}px`);
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
