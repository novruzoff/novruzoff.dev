---
import type { Metric, Project } from "../data/projects";

// One project as a compact card on /projects (see CLAUDE.md, Document pages):
//   title, the date line, and an award line if there is one
//   the one-liner (project.blurb)
//   up to three metrics: the first three of project.metrics (strongest first)
//   the main stack: the first `stackOnCard` items (default 4)
//   links, always visible
//   a native <details> fold with the bullets, plus any metrics and stack
//     items the card face had no room for, so nothing on the project is lost.
// id={slug} so /projects#<slug> deep-links; projects.astro's inline script
// opens the fold of the card the URL points at. The toggle itself is plain
// HTML (<details>/<summary>): no JS.
type Props = { project: Project };
const { project } = Astro.props;

const CARD_METRICS = 3;
const metrics: Metric[] = project.metrics ?? [];
const cardMetrics = metrics.slice(0, CARD_METRICS);
const moreMetrics = metrics.slice(CARD_METRICS);

const stack = project.stack ?? [];
const stackOnCard = project.stackOnCard ?? 4;
const cardStack = stack.slice(0, stackOnCard);
const moreStack = stack.slice(stackOnCard);

const highlights = project.highlights ?? [];
const hasDetails = highlights.length > 0 || moreMetrics.length > 0 || moreStack.length > 0;

// Every link the project has, in priority order. Lowercase labels, except
// "App Store", which keeps Apple's casing (CLAUDE.md, Case).
const links: { label: string; href: string }[] = [];
if (project.caseStudyUrl) links.push({ label: "case study", href: project.caseStudyUrl });
if (project.liveUrl) links.push({ label: "live", href: project.liveUrl });
if (project.appStoreUrl) links.push({ label: "App Store", href: project.appStoreUrl });
if (project.repoUrl) links.push({ label: "repo", href: project.repoUrl });

// Off-site links open in a new tab; pages on this site (/penknife) don't.
const target = (url: string) =>
  /^https?:\/\//.test(url) ? { target: "_blank", rel: "noreferrer noopener" } : {};
---

<article class="project-card" id={project.slug}>
  <h2 class="pc-title">{project.title}</h2>
  <p class="pc-meta">{project.dates}</p>
  {project.award && <p class="pc-meta pc-award">{project.award}</p>}

  <p class="pc-line">{project.blurb}</p>

  {
    cardMetrics.length > 0 && (
      <ul class="pc-metrics">
        {cardMetrics.map((m) => (
          <li>
            <span class="pc-value">{m.value}</span> <span class="pc-label">{m.label}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    cardStack.length > 0 && (
      <ul class="pc-stack" aria-label="Stack">
        {cardStack.map((tech) => <li>{tech}</li>)}
      </ul>
    )
  }

  {
    links.length > 0 && (
      <ul class="pc-links">
        {links.map((link) => (
          <li>
            {/* Label on the <a> line: whitespace would gap the arrow. */}
            <a href={link.href} {...target(link.href)} aria-label={`${project.title}: ${link.label}`}>{link.label}<span class="arrow" aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>
    )
  }

  {
    hasDetails && (
      <details class="pc-details">
        <summary>details</summary>
        {highlights.length > 0 && (
          <ul class="pc-highlights">
            {highlights.map((line) => <li>{line}</li>)}
          </ul>
        )}
        {moreMetrics.length > 0 && (
          <>
            <p class="pc-sub">more numbers</p>
            <ul class="pc-metrics">
              {moreMetrics.map((m) => (
                <li>
                  <span class="pc-value">{m.value}</span> <span class="pc-label">{m.label}</span>
                </li>
              ))}
            </ul>
          </>
        )}
        {moreStack.length > 0 && (
          <div class="pc-also">
            <span class="pc-sub-inline">also</span>
            <ul class="pc-stack">
              {moreStack.map((tech) => <li>{tech}</li>)}
            </ul>
          </div>
        )}
      </details>
    )
  }
</article>

<style>
  /* A panel-style card: 0.5px frame, no fill, so it reads like the
     homepage panels; the metrics keep the old tiles' elevated box and
     muted-blue values. */
  .project-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 18px;
    border: 0.5px solid var(--border-subtle);
  }
  @media (max-width: 639px) {
    .project-card {
      padding: 16px;
    }
  }

  .pc-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-primary);
  }
  /* Date and award: metadata (12px --text-tertiary, 4.98:1). */
  .pc-meta {
    margin-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-tertiary);
  }
  .pc-award {
    margin-top: 2px;
  }

  .pc-line {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* Metrics: value | label rows in an elevated box. Each row is a subgrid
     of the list, so every value lines up in one column whatever its width.
     --accent on --bg-elevated is 5.10:1; the label wraps if the card is
     narrow, the value never does. */
  .pc-metrics {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 12px;
    row-gap: 4px;
    margin-top: 14px;
    padding: 10px 12px;
    border: 0.5px solid var(--border-subtle);
    border-radius: 4px;
    background: var(--bg-elevated);
  }
  .pc-metrics li {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
  }
  .pc-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pc-label {
    font-size: 12px;
    line-height: 1.4;
    color: var(--text-tertiary);
  }

  /* Stack: inline list, "·" after each item but the last, so a wrapped
     line never starts with a separator. Decorative: not announced. */
  .pc-stack {
    display: flex;
    flex-wrap: wrap;
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .pc-stack li:not(:last-child)::after {
    content: "·";
    content: "·" / "";
    margin-inline: 8px;
    color: var(--text-tertiary);
  }

  /* 6px of block padding: each link is ~31px tall (WCAG 2.5.8). */
  .pc-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    margin-top: 6px;
    font-size: 12px;
  }
  .pc-links a {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    padding-block: 6px;
    color: var(--accent);
    transition: color 180ms var(--ease-out-expo);
  }
  @media (hover: hover) {
    .pc-links a:hover {
      color: var(--text-primary);
    }
    .pc-links a:hover .arrow {
      transform: translate(2px, -2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pc-links a:hover .arrow {
      transform: none;
    }
  }

  /* The fold: a native <details>, separated by a hairline. The default
     triangle is replaced by a decorative "+" / "−" (not announced: the
     summary's expanded state is exposed natively). 8px of block padding
     makes the summary ~35px tall. */
  .pc-details {
    margin-top: 12px;
    border-top: 0.5px solid var(--border-subtle);
  }
  .pc-details summary {
    display: inline-block;
    padding-block: 8px;
    font-size: 12px;
    color: var(--accent);
    cursor: pointer;
    list-style: none;
    transition: color 180ms var(--ease-out-expo);
  }
  .pc-details summary::-webkit-details-marker {
    display: none;
  }
  .pc-details summary::before {
    content: "+";
    content: "+" / "";
    display: inline-block;
    width: 2ch;
    color: var(--text-tertiary);
  }
  .pc-details[open] summary::before {
    content: "−";
    content: "−" / "";
  }
  .pc-details summary:hover {
    color: var(--text-primary);
  }

  /* Bullets, with a hanging decorative "-". */
  .pc-highlights {
    margin-top: 4px;
  }
  .pc-highlights li {
    position: relative;
    padding-left: 2ch;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .pc-highlights li + li {
    margin-top: 6px;
  }
  .pc-highlights li::before {
    content: "-";
    content: "-" / "";
    position: absolute;
    left: 0;
    color: var(--text-tertiary);
  }

  .pc-sub {
    margin-top: 14px;
    font-size: 11px;
    color: var(--text-tertiary);
  }
  .pc-sub + .pc-metrics {
    margin-top: 6px;
  }
  .pc-also {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 12px;
    margin-top: 12px;
  }
  .pc-also .pc-stack {
    margin-top: 0;
  }
  .pc-sub-inline {
    font-size: 11px;
    color: var(--text-tertiary);
  }
</style>
