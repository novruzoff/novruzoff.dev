---
import type { Project } from "../data/projects";

type Props = { project: Project; index?: number };
const { project, index = 0 } = Astro.props;

const href = project.caseStudyUrl ?? project.liveUrl ?? project.repoUrl;
const label = project.caseStudyUrl
  ? "Case study"
  : project.liveUrl
    ? "Live"
    : project.repoUrl
      ? "Repo"
      : null;
---

<article class="project-row" data-reveal style={`--reveal-i: ${index}`}>
  <span class="row-date mono">{project.dates}</span>

  <div class="row-content">
    <h3 class="row-title">
      {
        href ? (
          <a href={href} target="_blank" rel="noreferrer noopener">
            {project.title}
          </a>
        ) : (
          project.title
        )
      }
    </h3>
    <p class="row-blurb">{project.blurb}</p>
  </div>

  <span class="row-aff mono">
    {
      href && label ? (
        <a
          class="row-link"
          href={href}
          target="_blank"
          rel="noreferrer noopener"
          aria-label={`${project.title}: ${label}`}
        >
          {label}<span class="arrow" aria-hidden="true">↗</span>
        </a>
      ) : null
    }
  </span>
</article>
