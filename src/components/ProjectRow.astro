---
import type { Project } from "../data/projects";

type Props = { project: Project; index?: number };
const { project, index = 0 } = Astro.props;

// Every link the project has, in priority order; the title uses the first.
const links: { label: string; href: string }[] = [];
if (project.caseStudyUrl) links.push({ label: "Case study", href: project.caseStudyUrl });
if (project.liveUrl) links.push({ label: "Live", href: project.liveUrl });
if (project.repoUrl) links.push({ label: "Repo", href: project.repoUrl });
const href = links[0]?.href;
---

<article class="project-row" data-reveal style={`--reveal-i: ${index}`}>
  <span class="row-date mono">{project.dates}</span>

  <div class="row-content">
    <h3 class="row-title">
      {
        href ? (
          <a href={href} target="_blank" rel="noreferrer noopener">
            {project.title}
          </a>
        ) : (
          project.title
        )
      }
    </h3>
    <p class="row-blurb">{project.blurb}</p>
  </div>

  <span class="row-aff mono">
    {
      links.map((link) => (
        <a
          class="row-link"
          href={link.href}
          target="_blank"
          rel="noreferrer noopener"
          aria-label={`${project.title}: ${link.label}`}
        >
          {link.label}<span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))
    }
  </span>
</article>
