---
// Section heading + optional mono meta (a count, "4 roles") and a hairline.
// Used by /resume and the Penknife pages. `id` goes on the <h2>, so a
// <section aria-labelledby={id}> is named by its visible heading.
type Props = {
  label: string;
  meta?: string;
  id?: string;
};

const { label, meta, id } = Astro.props;
---

<header class="section-head">
  <h2 id={id}>{label}</h2>
  {meta && <span class="meta mono">{meta}</span>}
</header>
<span class="section-rule" aria-hidden="true"></span>
