---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  /** Site-relative path to a 1200×630 PNG social card. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Person JSON-LD for Murad. Home page only in practice. */
  personSchema?: boolean;
  /** Preload the Cormorant subset (the hero handle is above the fold). */
  preloadHandleFont?: boolean;
  /** The hero / reveal / nav motion gates. Only pages with those scripts. */
  motionGates?: boolean;
  /** App Store app ID; adds Safari's Smart App Banner. Penknife pages only. */
  appStoreId?: string;
};

const {
  title = "Murad Novruzov — Software engineer",
  description = "Software engineer in Montreal. Founding Developer at True Competency, studying CS at McGill.",
  ogImage: ogImagePath = "/og.png",
  ogImageAlt = "“novruzoff” in large italic type, under “Murad Novruzov — Software engineer”.",
  personSchema = true,
  preloadHandleFont = true,
  motionGates = true,
  appStoreId,
} = Astro.props;

// build.format 'file' reports pages as /index.html and /penknife/privacy.html.
// The served URLs are / and /penknife/privacy (vercel.json cleanUrls), so
// strip the file extension and the index segment.
const pathname = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";
const canonical = Astro.site
  ? new URL(pathname, Astro.site).href
  : undefined;

// Social card: public/og.png by default, 1200×630. Crawlers need an absolute URL.
const ogImage = new URL(ogImagePath, Astro.site ?? Astro.url).href;

const personSchemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Murad Novruzov",
  url: "https://novruzoff.dev",
  email: "mailto:murad@novruzoff.dev",
  jobTitle: ["Founding Developer", "Software Engineer"],
  worksFor: {
    "@type": "Organization",
    name: "True Competency",
    url: "https://truecompetency.com",
  },
  // Still enrolled (expected May 2027), so affiliation rather than alumniOf.
  affiliation: { "@type": "CollegeOrUniversity", name: "McGill University" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Montreal",
    addressCountry: "CA",
  },
  sameAs: [
    "https://github.com/novruzoff",
    "https://linkedin.com/in/novruzoff",
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {motionGates && <script is:inline>
      // Motion gates: while these classes are on <html>, CSS holds the hero,
      // [data-reveal] content, and the site nav at their start states. Module
      // scripts run before DOMContentLoaded, so a gate still unclaimed by then
      // means its script failed to load — drop it and show static content.
      (() => {
        const root = document.documentElement;
        root.classList.add("js-hero", "js-reveal", "js-nav");
        document.addEventListener("DOMContentLoaded", () => {
          if (!root.classList.contains("hero-live")) root.classList.remove("js-hero");
          if (!root.classList.contains("reveal-live")) root.classList.remove("js-reveal");
          if (!root.classList.contains("nav-live")) root.classList.remove("js-nav");
        });
      })();
    </script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {preloadHandleFont && (
      <link
        rel="preload"
        href="/fonts/cormorant-italic-600-novruzov.woff2"
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    )}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f0f10" />
    {appStoreId && <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="novruzoff.dev" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {personSchema && (
      <script is:inline type="application/ld+json" set:html={personSchemaJson} />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
