---
// /contact: one line, the email as the main action, then the profiles.
// No form (out of scope; mailto only). Static: no JS.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const EMAIL = "murad@novruzoff.dev";

// Label | value rows. The value is the readable address, so what's on
// screen is exactly where the link goes. Brand names keep their casing.
// Instagram and X block automated link checks; these handles are confirmed
// (an exception to CLAUDE.md's "omit links that don't resolve" rule).
const profiles = [
  { label: "GitHub", value: "github.com/novruzoff", href: "https://github.com/novruzoff" },
  { label: "LinkedIn", value: "linkedin.com/in/novruzovmurad", href: "https://www.linkedin.com/in/novruzovmurad/" },
  { label: "Instagram", value: "instagram.com/novruzoffmurad", href: "https://www.instagram.com/novruzoffmurad/" },
  { label: "X", value: "x.com/novruzoffmurad", href: "https://x.com/novruzoffmurad" },
];
---

<Layout
  title="Contact — Murad Novruzov"
  description="Get in touch with Murad Novruzov: open to internships, contract work, and interesting problems. murad@novruzoff.dev."
  ogImage="/og/contact.png"
  ogImageAlt="“contact” in large monospace type on a blue panel, beside “open to internships, contract work, and interesting problems.”, the email murad@novruzoff.dev and the GitHub and LinkedIn handles."
  personSchema={false}
>
  <Header />

  <main class="wrap doc">
    {/* One column below 1024px (heading, line, email, then the links), two
        from 1024px: heading, line and email on the left, links on the right. */}
    <div class="contact-grid">
      <div class="contact-intro">
        <header class="doc-head">
          <h1>contact</h1>
          <p class="lead">open to internships, contract work, and interesting problems.</p>
        </header>

        <a class="contact-email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>

    <dl class="profiles">
      {
        profiles.map((profile) => (
          <div>
            <dt>{profile.label}</dt>
            <dd>
              {/* Value on the <a> line: whitespace would gap the arrow. */}
              <a href={profile.href} target="_blank" rel="noreferrer noopener">{profile.value}<span class="arrow" aria-hidden="true">↗</span></a>
            </dd>
          </div>
        ))
      }
    </dl>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Layout ───────────────────────────────────────────────
     Below 1024px: one column, each block capped at --measure like the
     other document pages. From 1024px: two equal columns across the full
     page edges, the intro (heading, line, email) on the left and the links
     list on the right, its top hairline level with the heading. */
  .doc > .contact-grid {
    max-width: none;
  }
  .contact-grid > * {
    max-width: var(--measure);
  }
  @media (min-width: 1024px) {
    .contact-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      column-gap: clamp(40px, 4vw, 72px);
    }
    .contact-grid > * {
      max-width: none;
    }
    .contact-grid .profiles {
      margin-top: 0;
    }
  }

  /* The email is the page's one action: bigger, blue, underlined. */
  .contact-email {
    margin-top: 28px;
    font-size: clamp(16px, 3.6vw, 20px);
  }

  .profiles {
    margin-top: 32px;
    border-top: 0.5px solid var(--border-subtle);
  }
  /* 80px fits "LinkedIn" (53px at 11px). The longest value with its arrow,
     "linkedin.com/in/novruzovmurad ↗", is 258px at 14px, so the row needs
     354px (it fits from 401px, whose row is 361px); under 400px the label
     goes above the value instead. */
  .profiles > div {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    border-bottom: 0.5px solid var(--border-subtle);
  }
  .profiles dt {
    font-size: 11px;
    color: var(--text-tertiary);
  }
  @media (max-width: 400px) {
    .profiles > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .profiles dt {
      padding-top: 12px;
    }
    .profiles a {
      padding-top: 2px;
    }
  }
  /* 10px of block padding: each row link is ~37px tall (WCAG 2.5.8). */
  .profiles a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding-block: 10px;
    font-size: 14px;
    color: var(--text-secondary);
    overflow-wrap: anywhere;
    transition: color 180ms var(--ease-out-expo);
  }
  .profiles .arrow {
    display: inline-block;
    color: var(--text-tertiary);
    transition:
      color 180ms var(--ease-out-expo),
      transform 240ms var(--ease-out-expo);
  }
  @media (hover: hover) {
    .profiles a:hover {
      color: var(--text-primary);
    }
    .profiles a:hover .arrow {
      color: var(--accent);
      transform: translate(2px, -2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .profiles a:hover .arrow {
      transform: none;
    }
  }
</style>
