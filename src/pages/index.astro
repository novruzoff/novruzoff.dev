---
// Home: a full-viewport row of vertical panels (see CLAUDE.md, Layout).
//   1 photo a · 2 greeting (blue fill) · 3 video loop · 4 statement · 5 photo b
// It's the vibe page: no metrics, no timeline, no project list; the header
// links carry visitors to /projects, /resume and /contact.
//
// Media is optional at build time. Each asset is looked up in
// src/assets/home/ with import.meta.glob, so a missing file is simply absent
// (no import error) and its panel renders a labelled placeholder instead.
//   photo-a.{jpg,jpeg,png,webp,avif,tif,tiff}   portrait, ~2:3
//   photo-b.{…same}                              portrait, ~4:5
//   loop.webm and/or loop.mp4                    portrait 9:16, no audio
//   loop-poster.{…same as photos}                the loop's first frame
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PanelPhoto, { type PanelCrop } from "../components/PanelPhoto.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/home/*.{jpg,jpeg,png,webp,avif,tif,tiff}",
  { eager: true }
);
// ?url makes Vite copy the file into the build with a hashed name and hand
// back its URL; video isn't processed, only served.
const videos = import.meta.glob<string>("../assets/home/loop.{webm,mp4}", {
  eager: true,
  query: "?url",
  import: "default",
});

const findImage = (name: string) =>
  Object.entries(images).find(([path]) =>
    new RegExp(`/${name}\\.[a-z]+$`).test(path)
  )?.[1].default;

const photoA = findImage("photo-a");
const photoB = findImage("photo-b");
const posterImage = findImage("loop-poster");

// WebM (VP9/AV1, smaller) first, MP4 (H.264) as the fallback Safari and
// older browsers pick. The browser plays the first type it supports.
const loopSources = Object.entries(videos)
  .map(([path, src]) => ({
    src,
    type: path.endsWith(".webm") ? "video/webm" : "video/mp4",
  }))
  .sort((a, b) => (a.type === "video/webm" ? -1 : b.type === "video/webm" ? 1 : 0));

const poster = posterImage
  ? (await getImage({ src: posterImage, format: "webp", width: 720 })).src
  : undefined;

// Alt text: describe the photo once the real one lands. Empty alt marks an
// image as decorative, which is correct only if it carries no information.
const PHOTO_A_ALT = "";
const PHOTO_B_ALT = "";

// Photo crops, one per layout, matching the panel shapes in the <style> below
// (media conditions mirror its breakpoints and the 640px height lock).
//
// Panel geometry, measured: the page chrome around the locked grid (header,
// paddings, frame, footer) is ~164px tall; columns are 20vw − 24px (five),
// 25vw − 25px (four), 50vw − 36px (2×2) and 50vw − 22px (phones). In the
// locked layouts the panel's shape follows the viewport, so the crop is the
// typical shape and object-fit: cover trims the rest. The image then renders
// at max(panel width, panel height × crop aspect): that's the `sizes` value.
// Browsers that can't parse max() in sizes skip it and use the panel width.
const LOCKED_5 = "(min-width: 1024px) and (min-height: 640px)";
const LOCKED_4 =
  "(min-width: 768px) and (max-width: 1023px) and (orientation: landscape) and (min-height: 640px)";
const LOCKED_2X2 = "(min-width: 640px) and (min-height: 640px)";
const COLS_5 = "calc(20vw - 24px)";
const COLS_4 = "calc(25vw - 25px)";
const COLS_2X2 = "calc(50vw - 36px)";
const COLS_PHONE = "calc(50vw - 22px)";

// Photo a is in every layout.
const PHOTO_A_CROPS: PanelCrop[] = [
  // Five columns, locked: ~1:2.8 at 1440×900 (0.36).
  {
    media: LOCKED_5,
    aspect: 9 / 25,
    sizes: `max(${COLS_5}, calc((100vh - 164px) * 0.36)), ${COLS_5}`,
  },
  // Four columns, landscape tablet, locked: ~0.42 at 1000×700.
  {
    media: LOCKED_4,
    aspect: 5 / 12,
    sizes: `max(${COLS_4}, calc((100vh - 164px) * 0.4167)), ${COLS_4}`,
  },
  // 2×2, locked (portrait tablets, 640–1023px): ~0.82–0.88.
  {
    media: LOCKED_2X2,
    aspect: 6 / 7,
    sizes: `max(${COLS_2X2}, calc((50vh - 88px) * 0.857)), ${COLS_2X2}`,
  },
  // Four or five columns on a short screen: the panels keep a fixed 2:3.
  {
    media: "(min-width: 1024px), (min-width: 768px) and (orientation: landscape)",
    aspect: 2 / 3,
    sizes: `(min-width: 1024px) ${COLS_5}, ${COLS_4}`,
  },
  // Default: phones and short 2×2 layouts, a fixed 3:4.
  { aspect: 3 / 4, sizes: `(min-width: 640px) ${COLS_2X2}, ${COLS_PHONE}` },
];

// Photo b only shows from 1024px up (five columns): locked, or a fixed 2:3.
const PHOTO_B_CROPS: PanelCrop[] = [
  {
    media: LOCKED_5,
    aspect: 9 / 25,
    sizes: `max(${COLS_5}, calc((100vh - 164px) * 0.36)), ${COLS_5}`,
  },
  { aspect: 2 / 3, sizes: COLS_5 },
];
---

<Layout>
  <div class="home">
    <Header wide />

    <main class="wrap-wide home-main">
      <div class="panels">
        <div class="panel panel-media panel-a" style="--i: 0">
          {
            photoA ? (
              <PanelPhoto src={photoA} alt={PHOTO_A_ALT} crops={PHOTO_A_CROPS} priority />
            ) : (
              <div class="placeholder" aria-hidden="true">photo a</div>
            )
          }
        </div>

        <div class="panel panel-text panel-greet" style="--i: 1">
          <h1 class="display">
            <span>hi.</span>
            <span>i'm murad, a software engineer in montréal.</span>
          </h1>
        </div>

        <div class="panel panel-media panel-video" style="--i: 2">
          {
            loopSources.length > 0 ? (
              <>
                {/* No <source> in the HTML on purpose: the script adds them
                    after window load. Decorative, so hidden from assistive
                    tech and out of the tab order; the toggle below is the
                    accessible control. */}
                <video
                  class="media"
                  data-loop
                  data-sources={JSON.stringify(loopSources)}
                  poster={poster}
                  autoplay
                  muted
                  loop
                  playsinline
                  disablepictureinpicture
                  disableRemotePlayback
                  preload="none"
                  aria-hidden="true"
                  tabindex="-1"
                />
                <button type="button" class="loop-toggle" data-loop-toggle hidden>
                  pause
                </button>
              </>
            ) : (
              <div class="placeholder" aria-hidden="true">video</div>
            )
          }
        </div>

        <div class="panel panel-text panel-statement" style="--i: 3">
          <p class="display">i build software for the web, end to end.</p>
        </div>

        <div class="panel panel-media panel-b" style="--i: 4">
          {
            photoB ? (
              <PanelPhoto src={photoB} alt={PHOTO_B_ALT} crops={PHOTO_B_CROPS} />
            ) : (
              <div class="placeholder" aria-hidden="true">photo b</div>
            )
          }
        </div>
      </div>
    </main>

    <Footer wide />
  </div>

  {/* Inside <Layout> so it renders in <body>; after it would land past </html>. */}
  <script>
    // The loop video, and the only script on the page. Nothing else needs JS.
    // - Sources are attached after window load, so the video never competes
    //   with the LCP image for bandwidth (preload="none" until then).
    // - Plays only while on screen and the tab is visible.
    // - Reduced motion or Save-Data: never attached, so only the poster shows
    //   and the toggle stays hidden.
    // - The toggle (WCAG 2.2.2: moving content over 5s needs a pause) reflects
    //   the video's real state via play/pause events, so it also reads "play"
    //   when the browser blocks autoplay (e.g. iOS Low Power Mode).
    type LoopSource = { src: string; type: string };
    type NetworkInformationLike = { saveData?: boolean };

    const video = document.querySelector<HTMLVideoElement>("[data-loop]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-loop-toggle]");

    if (video && toggle) {
      let sources: LoopSource[] = [];
      try {
        sources = JSON.parse(video.dataset.sources ?? "[]");
      } catch {}

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const connection = (navigator as Navigator & { connection?: NetworkInformationLike })
        .connection;
      const saveData = connection?.saveData === true;

      if (sources.length > 0 && !reduce && !saveData) {
        let inView = false;
        let userPaused = false;

        const sync = () => {
          if (inView && !document.hidden && !userPaused) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        };

        const render = () => {
          const action = video.paused ? "play" : "pause";
          toggle.textContent = action;
          // Starts with the visible word, so voice control can say what it sees.
          toggle.setAttribute("aria-label", `${action} background video`);
        };

        const attach = () => {
          for (const { src, type } of sources) {
            const source = document.createElement("source");
            source.src = src;
            source.type = type;
            video.append(source);
          }
          video.load();
          toggle.hidden = false;
          render();
          new IntersectionObserver((entries) => {
            for (const entry of entries) inView = entry.isIntersecting;
            sync();
          }).observe(video);
          document.addEventListener("visibilitychange", sync);
        };

        video.addEventListener("play", render);
        video.addEventListener("pause", render);
        toggle.addEventListener("click", () => {
          userPaused = !video.paused;
          if (userPaused) video.pause();
          else video.play().catch(() => {});
        });

        if (document.readyState === "complete") attach();
        else window.addEventListener("load", attach, { once: true });
      }
    }
  </script>
</Layout>

<style>
  /* ── Page frame ───────────────────────────────────────────
     Header, panel grid, footer in one column. From 640px wide AND
     640px tall the column is locked to the viewport and the grid takes
     whatever height is left (the height guard: on shorter screens the
     panels keep their own aspect ratio and the page scrolls, so text can
     never be squeezed out of a panel). */
  .home {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }
  .home-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-top: 12px;
  }

  /* ── Grid ─────────────────────────────────────────────────
     Phones (< 640px): two columns that scroll, about one screen tall.
     Greeting across the top, photo a + video side by side, statement
     across the bottom. Photo b is hidden. No outer frame: at 343px of
     width it would only cost space. */
  .panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      "greet greet"
      "a     video"
      "state state";
    gap: 12px;
  }

  .panel {
    position: relative;
    min-width: 0;
    border: 0.5px solid var(--border-subtle);
    /* Text inside sizes itself to the panel's width (cqi units). */
    container-type: inline-size;
  }
  .panel-a {
    grid-area: a;
  }
  .panel-greet {
    grid-area: greet;
  }
  .panel-video {
    grid-area: video;
  }
  .panel-statement {
    grid-area: state;
  }
  .panel-b {
    grid-area: b;
    display: none;
  }

  /* Media panels own their shape; photos and video fill them, cropped from
     the center (object-fit: cover), whatever the source's proportions. */
  .panel-media {
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--bg-elevated);
  }
  .panel-media :global(.media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Missing asset: a quiet labelled block, so the layout reads as intended. */
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 11px;
    color: var(--text-tertiary);
  }

  /* ── Text panels ──────────────────────────────────────────
     Text panels never clip: they grow to fit their text, and the height
     guard keeps that from happening on locked layouts. */
  .panel-text {
    display: flex;
    flex-direction: column;
    padding: 16px;
  }
  .display {
    font-size: clamp(20px, 8.5cqi, 40px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .display span {
    display: block;
  }

  /* The two text panels are an inverted pair (--panel-dark / --panel-muted,
     5.23:1 either way). Greeting: muted text on dark, top-left. --panel-dark
     sits at 1.03:1 against the page, so the 0.5px --border-subtle frame every
     panel gets (.panel, above) is what separates it. */
  .panel-greet {
    justify-content: flex-start;
    background: var(--panel-dark);
    color: var(--panel-muted);
  }

  /* Statement: the inverse, dark text on muted, bottom-right. */
  .panel-statement {
    justify-content: flex-end;
    min-height: 112px;
    background: var(--panel-muted);
    color: var(--panel-dark);
    text-align: right;
  }

  /* ── Video toggle ─────────────────────────────────────────
     Small mono label, bottom-left over the video. Its own near-opaque
     backdrop keeps it legible over any frame: --accent on it measures
     4.73:1 even over a pure white frame (at 0.92 it was 4.47:1, a fail,
     once --accent became the muted blue). Hover goes to --text-primary.
     6px of block padding: ~30px tall (WCAG 2.5.8). */
  .loop-toggle {
    position: absolute;
    left: 8px;
    bottom: 8px;
    z-index: 1;
    padding: 6px 10px;
    border: 0.5px solid var(--border);
    border-radius: 2px;
    background: rgba(15, 15, 16, 0.94);
    font: inherit;
    font-size: 11px;
    line-height: 1.6;
    color: var(--accent);
    cursor: pointer;
    transition: color 180ms var(--ease-out-expo);
  }
  .loop-toggle:hover {
    color: var(--text-primary);
  }
  .loop-toggle[hidden] {
    display: none;
  }

  /* ── 640px and up: 2×2 ────────────────────────────────────
     photo a + greeting on top, video + statement below, photo b hidden.
     This also covers portrait tablets up to 1023px: four columns there
     would be ~170px wide and ~900px tall, a sliver, not a panel. */
  @media (min-width: 640px) {
    .home-main {
      padding-bottom: 12px;
    }
    .panels {
      grid-template-areas:
        "a     greet"
        "video state";
      padding: 12px;
      border: 0.5px solid var(--border-subtle);
    }
    .panel-text {
      padding: 18px;
    }
    .display {
      font-size: clamp(20px, 10cqi, 44px);
    }
    .panel-statement {
      min-height: 0;
    }
  }

  /* ── 768–1023px, landscape: four columns, photo b hidden ──── */
  @media (min-width: 768px) and (max-width: 1023px) and (orientation: landscape) {
    .panels {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-areas: "a greet video state";
    }
    .panel-media {
      aspect-ratio: 2 / 3;
    }
    .display {
      font-size: clamp(18px, 12cqi, 44px);
    }
  }

  /* ── 1024px and up: all five ─────────────────────────────── */
  @media (min-width: 1024px) {
    .panels {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      grid-template-areas: "a greet video state b";
    }
    .panel-b {
      display: block;
    }
    .panel-media {
      aspect-ratio: 2 / 3;
    }
    .display {
      font-size: clamp(18px, 12cqi, 48px);
    }
  }

  /* ── Height lock (the guard's other side) ─────────────────
     Tall enough: the page is exactly one viewport and the grid's rows
     share what's left, so media panels drop their aspect ratio and fill
     their cell. */
  @media (min-width: 640px) and (min-height: 640px) {
    .home {
      height: 100vh;
      height: 100dvh;
    }
    .home-main {
      min-height: 0;
    }
    .panels {
      flex: 1;
      min-height: 0;
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }
    .panel-media {
      aspect-ratio: auto;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) and (orientation: landscape) and (min-height: 640px),
    (min-width: 1024px) and (min-height: 640px) {
    .panels {
      grid-template-rows: minmax(0, 1fr);
    }
  }

  /* ── Entrance ─────────────────────────────────────────────
     CSS only, no gate: each panel fades and rises 12px over 500ms
     (ease-out-expo), 70ms apart left to right (--i). Nothing is hidden
     unless motion is allowed, so reduced motion gets the static page.

     Except photo a, which doesn't animate at all. It's the page's main
     image (fetchpriority high), and an element that starts at opacity 0
     isn't a Largest Contentful Paint candidate: with the fade, Lighthouse
     reported the footer text as LCP. A rise without the fade would leave
     a large photo visibly sliding 12px at first paint, which reads as a
     shift rather than an entrance, so it simply sits still and anchors
     the row while the other panels arrive beside it (their delays still
     count from it: 70ms, 140ms…). */
  @media (prefers-reduced-motion: no-preference) {
    .panel {
      animation: panel-in 500ms var(--ease-out-expo) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }
    .panel-a {
      animation: none;
    }
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
