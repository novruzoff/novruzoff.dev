---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectRow from "../components/ProjectRow.astro";
import ExperienceRow from "../components/ExperienceRow.astro";
import { projects } from "../data/projects";
import { experience } from "../data/experience";

const year = new Date().getFullYear();
---

<Layout>
  <main class="mx-auto w-full max-w-[720px] px-6 sm:px-8 md:px-10">
    <!-- Top nav -->
    <nav
      class="flex items-baseline justify-between pt-8 pb-6"
    >
      <a
        href="/"
        class="text-[15px] font-medium tracking-tight"
        style="color: var(--text-primary);"
      >
        Murad Novruzov
      </a>
      <ul class="mono flex items-baseline gap-5 text-[12px]" style="color: var(--text-secondary);">
        <li><a href="#work" class="hover:text-[color:var(--text-primary)] transition-colors">work</a></li>
        <li><a href="#writing" class="hover:text-[color:var(--text-primary)] transition-colors">writing</a></li>
        <li><a href="#about" class="hover:text-[color:var(--text-primary)] transition-colors">about</a></li>
      </ul>
    </nav>

    <!-- Hero -->
    <section id="about" class="pt-10 pb-16">
      <p
        class="mono text-[11px] mb-5"
        style="color: var(--text-tertiary);"
      >
        Montreal · CS @ McGill · available Sept 2026
      </p>
      <h1
        class="text-[28px] font-medium leading-[1.3] tracking-[-0.01em]"
        style="color: var(--text-primary);"
      >
        I build product-forward software for small teams that need to ship.
        Right now most of my time goes into
        <a
          href="https://truecompetency.com"
          target="_blank"
          rel="noreferrer noopener"
          class="whitespace-nowrap"
          style="color: var(--accent-light); border-bottom: 0.5px solid var(--accent-border);"
        >True&nbsp;Competency</a>,
        a clinical-training platform live with a paying client.
      </h1>
      <p
        class="mt-5 text-[15px]"
        style="color: var(--text-secondary);"
      >
        Previously: research on robotic manipulation, internal tooling at
        <a
          href="#work"
          style="color: var(--accent-light); border-bottom: 0.5px solid var(--accent-border);"
        >SSMU</a>,
        and a mental-health resource directory used across McGill.
      </p>
    </section>

    <!-- Selected work -->
    <section id="work" class="pb-16">
      <SectionHeader label="Selected work" meta={`${projects.length.toString().padStart(2, "0")} projects`} />
      {projects.map((project) => <ProjectRow project={project} />)}
    </section>

    <!-- Experience -->
    <section class="pb-16">
      <SectionHeader label="Experience" meta={`${experience.length.toString().padStart(2, "0")} roles`} />
      {experience.map((entry) => <ExperienceRow experience={entry} />)}
    </section>

    <!-- Writing placeholder -->
    <section id="writing" class="pb-16">
      <SectionHeader label="Writing" meta="soon" />
      <p
        class="py-4 text-[14px]"
        style="color: var(--text-tertiary); border-top: 0.5px solid var(--border-subtle);"
      >
        Notes on what I'm building will live here.
      </p>
    </section>

    <!-- Footer -->
    <footer
      class="mono flex flex-wrap items-baseline justify-between gap-y-2 py-6 mt-4 text-[11px]"
      style="border-top: 0.5px solid var(--border-subtle); color: var(--text-tertiary);"
    >
      <span>© {year} Murad Novruzov</span>
      <div class="flex items-baseline gap-4">
        <a
          href="mailto:murad@novruzoff.dev"
          style="color: var(--accent-light);"
        >
          murad@novruzoff.dev
        </a>
        <a
          href="https://github.com/novruzoff"
          target="_blank"
          rel="noreferrer noopener"
          class="hover:text-[color:var(--text-secondary)] transition-colors"
        >github</a>
        <a
          href="https://linkedin.com/in/novruzoff"
          target="_blank"
          rel="noreferrer noopener"
          class="hover:text-[color:var(--text-secondary)] transition-colors"
        >linkedin</a>
      </div>
    </footer>
  </main>
</Layout>
