---
// /projects: one compact card per project (ProjectCard), in projects.ts
// order, on a full-width grid. Each card is deep-linkable at
// /projects#<slug> (/resume links into these). The only JS is the tiny
// inline script at the end, which opens the targeted card's details.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";
import { projects } from "../data/projects";
---

<Layout
  title="Projects — Murad Novruzov"
  description="Projects by Murad Novruzov: True Competency, MindVista, Penknife, Brim AP Automation, SSMU club websites, OpenRobotics and MyMeetings, with stacks and numbers."
  ogImage="/og/projects.png"
  ogImageAlt="“projects” in large monospace type on a blue panel, beside the seven project names: True Competency, MindVista, Penknife, Brim AP Automation, SSMU websites, OpenRobotics and MyMeetings."
  personSchema={false}
>
  <Header />

  <main class="wrap doc">
    <header class="doc-head">
      <h1>projects</h1>
      <p class="meta mono">{projects.length} projects · what i built, the stack, the numbers</p>
    </header>

    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </main>

  {/* Landing on /projects#<slug> (e.g. from a /resume link): open that card's
      details and bring it into view (its scroll-margin clears the sticky
      header). Runs before the browser's own fragment scroll, and again on
      in-page hash changes. Inline and unminified on purpose: it's tiny. */}
  <script is:inline>
    (function () {
      function openTarget() {
        var card = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        var details = card && card.querySelector("details");
        if (!details) return;
        details.open = true;
        card.scrollIntoView();
      }
      openTarget();
      addEventListener("hashchange", openTarget);
    })();
  </script>

  <Footer />
</Layout>

<style>
  /* The one block on a document page that uses the full width (the rest
     are capped at --measure). 1 column on phones, 2 on tablets, 3 on
     laptops, 4 on very wide screens. align-items: start, so opening one
     card's details doesn't stretch the others in its row. */
  .doc > .project-grid {
    max-width: none;
  }
  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    margin-top: clamp(16px, 3vw, 24px);
  }
  @media (min-width: 640px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1600px) {
    .project-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
