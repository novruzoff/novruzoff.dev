---
// /resume: the lean version. About, a timeline of roles with one or two
// bullets each (each linking to its /projects entry for the detail),
// skills, education. Don't repeat project detail here; /projects carries
// it. Static: no JS, no reveals.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ExperienceRow from "../components/ExperienceRow.astro";
import Footer from "../components/Footer.astro";
import { experience } from "../data/experience";
import { skills, education, RESUME_PDF_URL } from "../data/resume";
---

<Layout
  title="Resume — Murad Novruzov"
  description="Murad Novruzov's resume: founding developer at True Competency, full stack developer and team lead at MindVista, CS at McGill (expected May 2027)."
  ogImage="/og/resume.png"
  ogImageAlt="“resume” in large monospace type on a blue panel, beside four roles: Founding Developer at True Competency, Full Stack Developer & Team Lead at MindVista, Web Developer at SSMU, and Web Development Intern at ARB."
  personSchema={false}
>
  <Header />

  <main class="wrap doc">
    <header class="doc-head">
      <h1>resume</h1>
      <p class="meta mono">
        the short version. the detail is on <a href="/projects">/projects</a>
        {
          RESUME_PDF_URL && (
            <>
              {" · "}
              <a href={RESUME_PDF_URL} download>download pdf</a>
            </>
          )
        }
      </p>
    </header>

    {/* Four sections in reading order (about, experience, skills,
        education): that's the single-column order below 1024px and what
        assistive tech gets. From 1024px the grid moves experience into a
        right-hand column beside the other three (see the style below). */}
    <div class="resume-grid">
    <section class="section resume-about" aria-labelledby="about">
      <SectionHeader label="about" id="about" />
      <div class="prose">
        <p>
          i'm murad novruzov, a.k.a. novruzoff, a software developer in montreal,
          born and raised in baku. i'm in my final year of computer science at <a
            href="https://mcgill.ca"
            target="_blank"
            rel="noreferrer noopener">McGill</a>, and i'm the founding developer at <a
            href="https://truecompetency.com"
            target="_blank"
            rel="noreferrer noopener">true competency</a>. most of my other work
          is full-stack web.
        </p>
      </div>
    </section>

    <section class="section resume-xp" aria-labelledby="experience">
      <SectionHeader label="experience" id="experience" meta={`${experience.length} roles`} />
      <ol class="timeline">
        {experience.map((entry) => <ExperienceRow experience={entry} />)}
      </ol>
    </section>

    <section class="section resume-skills" aria-labelledby="skills">
      <SectionHeader label="skills" id="skills" />
      <dl class="skills">
        {
          skills.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>
                <ul>
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="section resume-edu" aria-labelledby="education">
      <SectionHeader label="education" id="education" />
      <div class="education">
        <div class="edu-main">
          <span class="edu-degree">{education.degree}</span>
          <span class="edu-school">{education.school}</span>
        </div>
        <span class="edu-dates">{education.dates}</span>
      </div>
    </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Layout ───────────────────────────────────────────────
     Below 1024px: one column in reading order, each section capped at
     --measure like the rest of the document pages. From 1024px: two
     columns across the full page edges (the same edges as the header and
     the /projects grid): about, skills and education on the left,
     experience on the right spanning all three rows. 40/60, then 50/50
     from 1600px, where 60% would stretch the timeline past ~900px and
     pull each date away from its role again. Paragraphs keep their 70ch
     cap inside a column. */
  .doc > .resume-grid {
    max-width: none;
  }
  .resume-grid > .section {
    max-width: var(--measure);
  }
  @media (min-width: 1024px) {
    .resume-grid {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-areas:
        "about  xp"
        "skills xp"
        "edu    xp";
      /* The last row takes any spare height, so the left column stays
         packed at the top when the timeline is the taller side. */
      grid-template-rows: auto auto 1fr;
      align-items: start;
      column-gap: clamp(40px, 4vw, 72px);
    }
    .resume-grid > .section {
      max-width: none;
    }
    .resume-about {
      grid-area: about;
    }
    .resume-xp {
      grid-area: xp;
    }
    .resume-skills {
      grid-area: skills;
    }
    .resume-edu {
      grid-area: edu;
    }
  }
  @media (min-width: 1600px) {
    .resume-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* A link inside a line of text needs more than color to stand out (WCAG
     1.4.1): --accent vs the line's grey is only 1.15:1. The underline is
     the one the prose links use. */
  .doc-head .meta a {
    color: var(--accent);
    border-bottom: 0.5px solid var(--accent-border);
    transition: color 180ms var(--ease-out-expo);
  }
  .doc-head .meta a:hover {
    color: var(--text-primary);
  }

  /* The timeline sits a little below the header rule, like the old
     home page's section. */
  .timeline {
    margin-top: 6px;
  }

  /* Label column | items. 200px fits "infrastructure & security"
     (25 chars = 165px at 11px) on one line. Stacks under 560px. */
  .skills {
    margin-top: 16px;
  }
  .resume-skills {
    container-type: inline-size;
  }
  .skills > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px 16px;
    align-items: baseline;
  }
  .skills > div + div {
    margin-top: 12px;
  }
  .skills dt {
    font-size: 11px;
    color: var(--text-tertiary);
  }
  .skills dd ul {
    display: flex;
    flex-wrap: wrap;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  /* Separator after each item but the last, so a wrapped line ends on a
     dot instead of starting with one. Decorative: not announced. */
  .skills li:not(:last-child)::after {
    content: "·";
    content: "·" / "";
    margin-inline: 8px;
    color: var(--text-tertiary);
  }
  /* Label beside items only when the section is wide enough: the skills
     section can be the narrow left column (≈380px at 1024px) or a phone,
     where the label sits above its items instead. */
  @container (min-width: 500px) {
    .skills > div {
      grid-template-columns: 200px minmax(0, 1fr);
    }
  }

  /* Same shape as a timeline node, without the line: degree over school
     on the left, date on the right. */
  .education {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 18px;
    align-items: baseline;
    margin-top: 16px;
  }
  .edu-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .edu-degree {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .edu-school {
    font-size: 14px;
    color: var(--text-secondary);
  }
  .edu-dates {
    font-size: 11px;
    color: var(--text-tertiary);
    white-space: nowrap;
  }
</style>
